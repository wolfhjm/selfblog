ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now
SESSION_SECRET=replace-with-a-long-random-secret

# glm is the default. openai-compatible gateways can set a custom base URL.
AI_PROVIDER=glm
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=
AI_MODEL=glm-4-plus
AI_WIRE_API=chat_completions

# New API gateway example. Set AI_PROVIDER=newapi to use this block.
# NEWAPI_BASE_URL=http://119.29.173.211:13000/v1
# NEWAPI_API_KEY=sk-or-token-from-newapi
# NEWAPI_MODEL=glm-4.7
# NEWAPI_WIRE_API=chat_completions

# sub2 / ccswitch-like OpenAI compatible example:
# AI_PROVIDER=sub2
# AI_BASE_URL=https://your-sub2-domain.example
# AI_API_KEY=sk-...
# AI_MODEL=gpt-5.4
# AI_WIRE_API=responses
